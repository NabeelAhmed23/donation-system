generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  suspended
  deactivated
  /// Created by an invitation that has not been accepted yet; has no password and cannot sign in.
  invited

  @@map("user_status")
}

/// Global identity. Emails are stored lower-cased (enforced by a CHECK constraint in the migration).
/// Only an invited user may have no password hash (CHECK constraint in the migration).
model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  email              String     @unique
  passwordHash       String?    @map("password_hash")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  status             UserStatus @default(active)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  membership    Membership?
  platformRoles UserPlatformRole[]

  @@map("users")
}

/// A charity (tenant). Names are unique case-insensitively, and country and currency are ISO codes
/// (expression index and CHECK constraints in the migration).
model Organisation {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  /// Free-text information about the charity.
  description     String?
  /// ISO 3166-1 alpha-2, e.g. GB.
  country         String
  /// ISO 4217, e.g. GBP.
  defaultCurrency String   @map("default_currency")
  /// IANA time zone, e.g. Europe/London.
  timeZone        String   @map("time_zone")
  /// Stored lower-cased (CHECK constraint in the migration).
  contactEmail    String?  @map("contact_email")
  contactPhone    String?  @map("contact_phone")
  addressLine1    String?  @map("address_line1")
  addressLine2    String?  @map("address_line2")
  city            String?
  region          String?
  postalCode      String?  @map("postal_code")
  /// Optimistic-concurrency version: a settings change applies only to the version it was based on.
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships  Membership[]
  roles        Role[]
  auditEntries AuditLog[]

  @@map("organisations")
}

/// A user's link to their (single) organisation.
model Membership {
  id        String   @id @default(uuid(7)) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation     @relation(fields: [orgId], references: [id])
  user         User             @relation(fields: [userId], references: [id])
  roles        MembershipRole[]

  @@unique([orgId, id])
  @@map("memberships")
}

/// An organisation-defined role. Platform roles never live here.
model Role {
  id        String   @id @default(uuid(7)) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organisation Organisation     @relation(fields: [orgId], references: [id])
  memberships  MembershipRole[]
  permissions  RolePermission[]

  @@unique([orgId, id])
  @@unique([orgId, name])
  @@map("roles")
}

/// Composite (org_id, …) foreign keys stop a role from being linked to a member of another organisation.
model MembershipRole {
  orgId        String   @map("org_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  membership Membership @relation(fields: [orgId, membershipId], references: [orgId, id])
  role       Role       @relation(fields: [orgId, roleId], references: [orgId, id])

  @@id([membershipId, roleId])
  @@index([orgId, roleId])
  @@map("membership_roles")
}

/// One action (view, create, edit, delete, approve, manage; CHECK constraint in the migration) on one
/// area of the organisation, granted to a role. A user's effective permissions are the union over their roles.
model RolePermission {
  orgId     String   @map("org_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  area      String
  action    String
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  role Role @relation(fields: [orgId, roleId], references: [orgId, id], onDelete: Cascade)

  @@id([roleId, area, action])
  @@index([orgId])
  @@map("role_permissions")
}

/// Append-only record of who changed what and when (REQ-048). UPDATE and DELETE are refused by a trigger
/// in the migration; rows are visible only inside their organisation's tenant context (RLS).
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String
  entity      String
  entityId    String   @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  at          DateTime @default(now()) @map("ts") @db.Timestamptz(3)

  organisation Organisation @relation(fields: [orgId], references: [id])

  @@index([orgId, at])
  @@map("audit_log")
}

/// System-level roles (e.g. super_admin). Outside every organisation's RBAC (US-71).
model PlatformRole {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  holders UserPlatformRole[]

  @@map("platform_roles")
}

model UserPlatformRole {
  userId          String   @map("user_id") @db.Uuid
  platformRoleId  String   @map("platform_role_id") @db.Uuid
  grantedByUserId String?  @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id])
  platformRole PlatformRole @relation(fields: [platformRoleId], references: [id])

  @@id([userId, platformRoleId])
  @@index([platformRoleId])
  @@map("user_platform_roles")
}
